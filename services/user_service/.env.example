# Service Info
PROJECT_NAME="E-Commerce User & Auth Microservice"
SERVICE_NAME="user-service"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# MySQL Database Configuration
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DB="fastapi_user_db"

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

# Security & JWT Token Configurations
SECRET_KEY="replace_with_a_high_entropy_random_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]

# OpenTelemetry & Distributed Tracing (Jaeger)
OTEL_ENABLED=True
OTEL_SERVICE_NAME="user-service"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_SAMPLING_RATIO=1.0
LOG_FORMAT="json"

# Inter-Service Communication
NOTIFICATION_SERVICE_URL="http://localhost:8006"
